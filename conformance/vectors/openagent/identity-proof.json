{
  "category": "openagent",
  "name": "identity-proof",
  "description": "OpenAgent Core Protocol identity proofs (Section 15). The signing payload is the JCS (RFC 8785) UTF-8 bytes of the openagent-challenge-v1 object, with no framing. A proof is an Ed25519 signature, base64url without padding, plus the raw public key and the echoed nonce. Verifiers check the challenge shape first (type, nonce, timestamp, origin), then the nonce echo and key shape, then that the key is one they trust, then the signature. Keys are RFC 8032 section 7.1 TEST 1 (9d61...7f60) and TEST 2 (4ccd...a6fb).",
  "spec": "OpenAgent Core Protocol Specification Section 15.2-15.3",
  "vectors": [
    {
      "name": "canonicalize-challenge",
      "description": "JCS form of a challenge without realm: keys sort nonce, origin, timestamp, type",
      "tags": [
        "jcs",
        "challenge"
      ],
      "input": {
        "operation": "canonicalize_challenge",
        "challenge": {
          "type": "openagent-challenge-v1",
          "nonce": "a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1",
          "timestamp": "2026-10-19T12:00:00Z",
          "origin": "https://auth.example.com"
        }
      },
      "expected_output": {
        "canonical": "{\"nonce\":\"a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1a3f1\",\"origin\":\"https://auth.example.com\",\"timestamp\":\"2026-10-19T12:00:00Z\",\"type\":\"openagent-challenge-v1\"}"
      }
    },
    {
