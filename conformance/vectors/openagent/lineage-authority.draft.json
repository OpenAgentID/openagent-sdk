{
  "suite": "openagent.lineage-authority",
  "version": "1.0.0-draft",
  "status": "draft_pending_sigil_gal_taxonomy",
  "description": "Draft OpenAgent privileged lineage authority vectors shared by Rust and TypeScript. These pin runtime fail-closed behavior and auth-context fields without freezing exact Sigil GAL field names or final error taxonomy.",
  "coordination": {
    "requiredBeforeLocking": "Confirm exact Sigil GAL field names and error taxonomy with the Sigil team.",
    "oasBoundary": "OAS consumes Sigil/GAL only through resolver traits or adapters; no Sigil-specific imports are required by these vectors."
  },
  "vectors": [
    {
      "name": "hmr-direct-authority",
      "description": "Human root directly delegates privileged authority to an agent.",
      "tags": ["success", "hmr", "human_to_agent"],
      "input": {
        "operation": "verify_lineage_authority",
        "subjectDid": "did:oas:test:agent:hmr-bot",
        "rootDid": "did:oas:test:hmr:alice",
        "localChain": ["did:oas:test:hmr:alice", "did:oas:test:agent:hmr-bot"],
        "pathKind": "human_to_agent",
        "requiredScopes": ["openai:chat:completions"],
        "minFinalizedBlock": 100,
        "resolver": {
          "source": "sigil_gal_test",
          "currentFinalizedBlock": 120,
          "rootKind": "hmr",
          "rootStatus": "active",
          "rootAnchoredAtBlock": 90,
          "revokedDids": []
        }
      },
      "expected_output": {
        "ok": true,
        "context": {
          "subjectDid": "did:oas:test:agent:hmr-bot",
          "rootDid": "did:oas:test:hmr:alice",
          "authorityPathKind": "human_to_agent",
          "authoritySource": "sigil_gal_test",
          "generation": 1,
          "rootKind": "hmr",
          "orgRootCommitment": null
        }
      }
    },
    {
      "name": "mhr-authority",
