          "subjectDid": "did:oas:test:agent:other",
          "rootDid": "did:oas:test:hmr:alice"
        }
      },
      "expected_output": {
        "ok": false,
        "errorClass": "lineage_authority_malformed"
      }
    },
    {
      "name": "revoked-root",
