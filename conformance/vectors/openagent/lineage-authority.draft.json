        "errorClass": "lineage_authority_wrong_org_root"
      }
    },
    {
      "name": "stale-authority-context",
      "description": "Authority fails closed when resolver finality is below the required minimum.",
      "tags": ["failure", "stale"],
      "input": {
        "operation": "verify_lineage_authority",
        "subjectDid": "did:oas:test:agent:stale-bot",
        "rootDid": "did:oas:test:hmr:alice",
