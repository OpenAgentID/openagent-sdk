        "requiredScopes": ["arsenal:vault:write"],
        "minFinalizedBlock": 100,
        "resolver": {
          "source": "sigil_gal_test",
          "currentFinalizedBlock": 120,
          "rootKind": "mhr",
          "rootStatus": "active",
          "rootAnchoredAtBlock": 88,
          "revokedDids": []
        }
