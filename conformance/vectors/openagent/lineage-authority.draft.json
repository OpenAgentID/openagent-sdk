        "expectedOrgRootCommitment": "blake3:expected",
        "resolver": {
          "source": "sigil_gal_test",
          "currentFinalizedBlock": 120,
          "rootKind": "mhr",
          "rootStatus": "active",
          "rootAnchoredAtBlock": 90,
