{
  "name": "@openagentid/mcp",
  "version": "0.2.1",
  "description": "OpenAgent middleware for the Model Context Protocol \u2014 adds OAS identity, Arsenal capability tokens, and AEGIS authorization to any MCP server in three lines.",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git",
    "directory": "integrations/mcp/typescript"
  },
  "bugs": {
    "url": "https://github.com/OpenAgentID/openagent-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "require": "./dist/skills.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && vitest run",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@openagentid/sdk": "^0.7.2 || ^0.8.0"
  },
  "peerDependenciesMeta": {
    "@openagentid/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^9.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11",
    "zod": "^3.23.8",
    "@openagentid/sdk": "0.8.0"
  },
  "keywords": [
    "openagent",
    "mcp",
    "model-context-protocol",
    "middleware",
    "authentication",
    "identity",
    "did",
    "oas",
    "arsenal",
    "aegis",
    "agents"
  ]
}
