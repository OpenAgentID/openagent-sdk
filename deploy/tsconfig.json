{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "shared/**/*.ts",
    "aws-lambda/handler.ts",
    "docker/server.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
