{
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "name": "openagent-cloudflare-worker",
  "scripts": {
    "prepare": "node prepare-wasm.mjs",
    "build": "node prepare-wasm.mjs && wrangler deploy --dry-run --outdir dist",
    "typecheck": "node prepare-wasm.mjs && tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "@openagentid/sdk": "^0.7.2 || ^0.8.0",
    "@openagentid/crypto-wasm": "^0.1.1"
  }
}
