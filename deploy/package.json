{
  "name": "openagent-deployment-examples",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "aws-lambda",
    "cloudflare-worker",
    "docker",
    "vercel-edge"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/receiver.test.ts test/example.test.ts",
    "build:node": "npm run build -w openagent-docker && npm run build -w openagent-aws-lambda",
    "build:worker": "npm run build -w openagent-cloudflare-worker",
    "test:worker": "vitest run test/worker.test.ts",
    "build:vercel": "npm run build -w openagent-vercel-receiver",
    "test:vercel": "node test/vercel-production.mjs",
    "example:init": "node scripts/example.mjs init",
    "example:request": "node scripts/example.mjs request",
    "docker:start": "node --env-file=.receiver-example/receiver.env docker/dist/server.js"
  },
  "dependencies": {
    "@openagentid/sdk": "^0.7.2 || ^0.8.0",
    "@openagentid/crypto-wasm": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cborg": "6.1.3",
    "typescript": "^5.6.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.6",
    "miniflare": "4.20260730.0"
  }
}
