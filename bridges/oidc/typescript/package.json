{
  "name": "@openagentid/oidc",
  "version": "0.2.0",
  "description": "Verified agent OpenID Connect provider and LifeID federation adapter",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git",
    "directory": "bridges/oidc/typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "zod": "^3.23.8",
    "oidc-provider": "9.12.2",
    "@types/oidc-provider": "9.12.1"
  },
  "peerDependencies": {
    "@openagentid/arsenal-sdk": "^0.1.0",
    "@openagentid/oas-sdk": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "@openagentid/oas-sdk": {
      "optional": true
    },
    "@openagentid/arsenal-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "openagent",
    "oidc",
    "oauth2",
    "agent",
    "did",
    "identity",
    "token-exchange",
    "rfc8693"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
