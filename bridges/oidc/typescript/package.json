{
  "name": "@openagentid/oidc",
  "version": "0.3.0",
  "description": "Self-hosted agent OpenID Connect provider with the branded Continue as Agent button; LifeID federation optional",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git",
    "directory": "bridges/oidc/typescript"
  },
  "bugs": {
    "url": "https://github.com/OpenAgentID/openagent-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./button.css": "./styles/button.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./styles/button.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.button.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "zod": "^4.6.7",
    "oidc-provider": "9.12.2",
    "@types/oidc-provider": "9.12.1"
  },
  "peerDependencies": {
    "@openagentid/arsenal-sdk": "^0.1.0",
    "@openagentid/oas-sdk": "^1.0.2",
    "@openagentid/sdk": "^0.7.2 || ^0.8.0"
  },
  "peerDependenciesMeta": {
    "@openagentid/oas-sdk": {
      "optional": true
    },
    "@openagentid/arsenal-sdk": {
      "optional": true
    },
    "@openagentid/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagentid/sdk": "0.8.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "openagent",
    "oidc",
    "oauth2",
    "agent",
    "did",
    "identity",
    "token-exchange",
    "rfc8693",
    "continue-as-agent",
    "button",
    "browser"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
