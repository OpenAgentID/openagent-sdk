{
  "name": "@openagentid/scim",
  "version": "0.2.1",
  "description": "SCIM 2.0 provisioning bridge for OpenAgent \u2014 enterprise agent lifecycle via RFC 7644",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git",
    "directory": "bridges/scim/typescript"
  },
  "bugs": {
    "url": "https://github.com/OpenAgentID/openagent-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@openagentid/sdk": "^0.7.2 || ^0.8.0"
  },
  "peerDependenciesMeta": {
    "@openagentid/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11",
    "@openagentid/sdk": "0.8.0"
  },
  "keywords": [
    "openagent",
    "scim",
    "provisioning",
    "identity",
    "did",
    "oas",
    "enterprise",
    "rfc7644",
    "okta",
    "azure-ad"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
