{
  "name": "@openagentid/sdk",
  "version": "0.8.0",
  "description": "OpenAgent SDK source package for GitHub installs. The implementation lives in sdks/typescript.",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git"
  },
  "type": "module",
  "main": "./sdks/typescript/dist/index.cjs",
  "module": "./sdks/typescript/dist/index.js",
  "types": "./sdks/typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdks/typescript/dist/index.d.ts",
      "import": "./sdks/typescript/dist/index.js",
      "require": "./sdks/typescript/dist/index.cjs"
    },
    "./agent": {
      "types": "./sdks/typescript/dist/agent.d.ts",
      "import": "./sdks/typescript/dist/agent.js",
      "require": "./sdks/typescript/dist/agent.cjs"
    },
    "./identity": {
      "types": "./sdks/typescript/dist/identity.d.ts",
      "import": "./sdks/typescript/dist/identity.js",
      "require": "./sdks/typescript/dist/identity.cjs"
    },
    "./credentials": {
      "types": "./sdks/typescript/dist/credentials.d.ts",
      "import": "./sdks/typescript/dist/credentials.js",
      "require": "./sdks/typescript/dist/credentials.cjs"
    },
    "./verification": {
      "types": "./sdks/typescript/dist/verification.d.ts",
      "import": "./sdks/typescript/dist/verification.js",
      "require": "./sdks/typescript/dist/verification.cjs"
    },
    "./skills": {
      "types": "./sdks/typescript/dist/skills.d.ts",
      "import": "./sdks/typescript/dist/skills.js",
      "require": "./sdks/typescript/dist/skills.cjs"
    },
    "./errors": {
      "types": "./sdks/typescript/dist/errors.d.ts",
      "import": "./sdks/typescript/dist/errors.js",
      "require": "./sdks/typescript/dist/errors.cjs"
    },
    "./glyph": {
      "types": "./sdks/typescript/dist/glyph.d.ts",
      "import": "./sdks/typescript/dist/glyph.js",
      "require": "./sdks/typescript/dist/glyph.cjs"
    },
    "./identity-verification": {
      "types": "./sdks/typescript/dist/identity-verification.d.ts",
      "import": "./sdks/typescript/dist/identity-verification.js",
      "require": "./sdks/typescript/dist/identity-verification.cjs"
    },
    "./verification-api": {
      "types": "./sdks/typescript/dist/verification-api.d.ts",
      "import": "./sdks/typescript/dist/verification-api.js",
      "require": "./sdks/typescript/dist/verification-api.cjs"
    },
    "./oats": {
      "types": "./sdks/typescript/dist/oats.d.ts",
      "import": "./sdks/typescript/dist/oats.js",
      "require": "./sdks/typescript/dist/oats.cjs"
    },
    "./characters": {
      "types": "./sdks/typescript/dist/characters.d.ts",
      "import": "./sdks/typescript/dist/characters.js",
      "require": "./sdks/typescript/dist/characters.cjs"
    },
    "./character-api": {
      "types": "./sdks/typescript/dist/character-api.d.ts",
      "import": "./sdks/typescript/dist/character-api.js",
      "require": "./sdks/typescript/dist/character-api.cjs"
    },
    "./character-state": {
      "types": "./sdks/typescript/dist/character-state.d.ts",
      "import": "./sdks/typescript/dist/character-state.js",
      "require": "./sdks/typescript/dist/character-state.cjs"
    },
    "./character-animation": {
      "types": "./sdks/typescript/dist/character-animation.d.ts",
      "import": "./sdks/typescript/dist/character-animation.js",
      "require": "./sdks/typescript/dist/character-animation.cjs"
    },
    "./character-player": {
      "types": "./sdks/typescript/dist/character-player.d.ts",
      "import": "./sdks/typescript/dist/character-player.js",
      "require": "./sdks/typescript/dist/character-player.cjs"
    },
    "./browser": {
      "types": "./sdks/typescript/dist/browser/character-player.d.ts",
      "import": "./sdks/typescript/dist/browser/character-player.js"
    },
    "./local": {
      "types": "./sdks/typescript/dist/local-workspace.d.ts",
      "import": "./sdks/typescript/dist/local-workspace.js",
      "require": "./sdks/typescript/dist/local-workspace.cjs"
    },
    "./integrations": {
      "types": "./sdks/typescript/dist/integrations.d.ts",
      "import": "./sdks/typescript/dist/integrations.js",
      "require": "./sdks/typescript/dist/integrations.cjs"
    },
    "./integrations/oas": {
      "types": "./sdks/typescript/dist/integrations/oas.d.ts",
      "import": "./sdks/typescript/dist/integrations/oas.js",
      "require": "./sdks/typescript/dist/integrations/oas.cjs"
    },
    "./integrations/aegis": {
      "types": "./sdks/typescript/dist/integrations/aegis.d.ts",
      "import": "./sdks/typescript/dist/integrations/aegis.js",
      "require": "./sdks/typescript/dist/integrations/aegis.cjs"
    },
    "./integrations/arsenal": {
      "types": "./sdks/typescript/dist/integrations/arsenal.d.ts",
      "import": "./sdks/typescript/dist/integrations/arsenal.js",
      "require": "./sdks/typescript/dist/integrations/arsenal.cjs"
    },
    "./integrations/skills-policy": {
      "types": "./sdks/typescript/dist/integrations/skills-policy.d.ts",
      "import": "./sdks/typescript/dist/integrations/skills-policy.js",
      "require": "./sdks/typescript/dist/integrations/skills-policy.cjs"
    }
  },
  "files": [
    "sdks/typescript/dist",
    "sdks/typescript/README.md",
    "sdks/typescript/CHANGELOG.md",
    "sdks/typescript/LICENSE-APACHE",
    "sdks/typescript/LICENSE-MIT"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm --prefix sdks/typescript ci --ignore-scripts --no-audit --no-fund && npm --prefix sdks/typescript run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "jose": "^5.10.0",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6"
  },
  "bin": {
    "oaid": "./sdks/typescript/dist/cli.js"
  },
  "peerDependencies": {
    "@openagentid/aegis-sdk": "^0.1.0",
    "@openagentid/arsenal-sdk": "^0.1.0",
    "@openagentid/oas-sdk": "^1.0.2",
    "@openagentid/crypto-wasm": "^0.1.0",
    "@openagentid/skills-policy": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@openagentid/aegis-sdk": {
      "optional": true
    },
    "@openagentid/arsenal-sdk": {
      "optional": true
    },
    "@openagentid/oas-sdk": {
      "optional": true
    },
    "@openagentid/crypto-wasm": {
      "optional": true
    },
    "@openagentid/skills-policy": {
      "optional": true
    }
  },
  "keywords": [
    "openagent",
    "agent",
    "authentication",
    "identity",
    "did",
    "oas",
    "arsenal",
    "aegis",
    "credentials",
    "autonomous",
    "ai"
  ]
}
