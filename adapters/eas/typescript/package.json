{
  "name": "@openagentid/anchor-eas",
  "version": "0.2.0",
  "description": "Ethereum Attestation Service (EAS) adapter for the OAS lineage anchor seam: resolution via EAS GraphQL, publishing via the maintained EAS SDK.",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^2.4.0",
    "@noble/hashes": "^1.4.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ethereum-attestation-service/eas-contracts": "1.7.1",
    "ethers": "^6.13.2",
    "hardhat": "2.22.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "adm-zip": "^0.6.0",
    "cookie": "^0.7.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.6",
    "undici": "^6.28.0",
    "uuid": "^11.1.1",
    "@metamask/utils": "^11.0.0",
    "@metamask/abi-utils": "^3.0.0",
    "@openzeppelin/merkle-tree": "^1.0.8"
  }
}
