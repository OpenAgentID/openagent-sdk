{
  "name": "@openagentid/anchor-eas",
  "version": "0.2.0",
  "description": "Ethereum Attestation Service (EAS) adapter for the OAS lineage anchor seam: resolution via EAS GraphQL, publishing via the maintained EAS SDK.",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git",
    "directory": "adapters/eas/typescript"
  },
  "bugs": {
    "url": "https://github.com/OpenAgentID/openagent-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^2.4.0",
    "@noble/hashes": "^1.4.0",
    "viem": "^2.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ethereum-attestation-service/eas-contracts": "1.9.0",
    "ethers": "^6.13.2",
    "hardhat": "3.20.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "adm-zip": "^0.6.0",
    "cookie": "^0.7.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.6",
    "undici": "^6.28.0",
    "uuid": "^11.1.1",
    "@metamask/utils": "^11.0.0",
    "@metamask/abi-utils": "^3.0.0",
    "@openzeppelin/merkle-tree": "^1.0.8"
  }
}
