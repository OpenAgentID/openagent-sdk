{
  "name": "@openagentid/sdk",
  "version": "0.8.0",
  "description": "Open agent identity, local trust and verification, and live animated avatars. No hosted service required.",
  "license": "Apache-2.0 OR MIT",
  "author": "L1fe Labs, Inc. <eng@l1fe.ai>",
  "homepage": "https://openagent.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentID/openagent-sdk.git",
    "directory": "sdks/typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "require": "./dist/identity.cjs"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "require": "./dist/credentials.cjs"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "import": "./dist/verification.js",
      "require": "./dist/verification.cjs"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "require": "./dist/skills.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./glyph": {
      "types": "./dist/glyph.d.ts",
      "import": "./dist/glyph.js",
      "require": "./dist/glyph.cjs"
    },
    "./identity-verification": {
      "types": "./dist/identity-verification.d.ts",
      "import": "./dist/identity-verification.js",
      "require": "./dist/identity-verification.cjs"
    },
    "./verification-api": {
      "types": "./dist/verification-api.d.ts",
      "import": "./dist/verification-api.js",
      "require": "./dist/verification-api.cjs"
    },
    "./oats": {
      "types": "./dist/oats.d.ts",
      "import": "./dist/oats.js",
      "require": "./dist/oats.cjs"
    },
    "./characters": {
      "types": "./dist/characters.d.ts",
      "import": "./dist/characters.js",
      "require": "./dist/characters.cjs"
    },
    "./character-api": {
      "types": "./dist/character-api.d.ts",
      "import": "./dist/character-api.js",
      "require": "./dist/character-api.cjs"
    },
    "./character-state": {
      "types": "./dist/character-state.d.ts",
      "import": "./dist/character-state.js",
      "require": "./dist/character-state.cjs"
    },
    "./character-animation": {
      "types": "./dist/character-animation.d.ts",
      "import": "./dist/character-animation.js",
      "require": "./dist/character-animation.cjs"
    },
    "./character-player": {
      "types": "./dist/character-player.d.ts",
      "import": "./dist/character-player.js",
      "require": "./dist/character-player.cjs"
    },
    "./one": {
      "types": "./dist/one.d.ts",
      "import": "./dist/one.js",
      "require": "./dist/one.cjs"
    },
    "./browser": {
      "types": "./dist/browser/character-player.d.ts",
      "import": "./dist/browser/character-player.js"
    },
    "./browser/one": {
      "types": "./dist/browser/one.d.ts",
      "import": "./dist/browser/one.js"
    },
    "./local": {
      "types": "./dist/local-workspace.d.ts",
      "import": "./dist/local-workspace.js",
      "require": "./dist/local-workspace.cjs"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.js",
      "require": "./dist/integrations.cjs"
    },
    "./integrations/oas": {
      "types": "./dist/integrations/oas.d.ts",
      "import": "./dist/integrations/oas.js",
      "require": "./dist/integrations/oas.cjs"
    },
    "./integrations/aegis": {
      "types": "./dist/integrations/aegis.d.ts",
      "import": "./dist/integrations/aegis.js",
      "require": "./dist/integrations/aegis.cjs"
    },
    "./integrations/arsenal": {
      "types": "./dist/integrations/arsenal.d.ts",
      "import": "./dist/integrations/arsenal.js",
      "require": "./dist/integrations/arsenal.cjs"
    },
    "./integrations/skills-policy": {
      "types": "./dist/integrations/skills-policy.d.ts",
      "import": "./dist/integrations/skills-policy.js",
      "require": "./dist/integrations/skills-policy.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && vitest run",
    "clean": "rm -rf dist coverage",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "jose": "^5.10.0",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6"
  },
  "peerDependencies": {
    "@openagentid/aegis-sdk": "^0.1.0",
    "@openagentid/arsenal-sdk": "^0.1.0",
    "@openagentid/crypto-wasm": "^0.1.0",
    "@openagentid/oas-sdk": "^1.0.2",
    "@openagentid/skills-policy": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@openagentid/aegis-sdk": {
      "optional": true
    },
    "@openagentid/arsenal-sdk": {
      "optional": true
    },
    "@openagentid/oas-sdk": {
      "optional": true
    },
    "@openagentid/crypto-wasm": {
      "optional": true
    },
    "@openagentid/skills-policy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11",
    "@openagentid/crypto-wasm": "0.1.1",
    "cborg": "6.1.3",
    "express": "^5.1.0",
    "@openagentid/oas-sdk": "1.0.2",
    "@openagentid/arsenal-sdk": "0.1.1",
    "@openagentid/aegis-sdk": "0.1.1",
    "@openagentid/skills-policy": "0.1.1"
  },
  "keywords": [
    "openagent",
    "agent",
    "authentication",
    "identity",
    "did",
    "oas",
    "arsenal",
    "aegis",
    "credentials",
    "autonomous",
    "ai"
  ],
  "bin": {
    "oaid": "./dist/cli.js"
  }
}
